{
  "name": "aeris",
  "version": "0.1.0",
  "private": true,
  "description": "Aide à la décision pour dimensionner et coordonner l'emploi des drones en opération de gendarmerie (Hackathon Occitanie 2026)",
  "license": "MIT",
  "author": "Équipe Aeris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tug2co/aeris.git"
  },
  "bugs": {
    "url": "https://github.com/Tug2co/aeris/issues"
  },
  "homepage": "https://github.com/Tug2co/aeris#readme",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @aeris/api --filter @aeris/web dev",
    "dev:mock": "pnpm --filter @aeris/web dev --mode mock",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mocks": "pnpm --filter @aeris/api mocks"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
